# MedoOffline .gitignore
# Never commit scraped content or session files

# ---- CRITICAL: scraped data ----
data/
storage_state.json
*.storage_state.json

# ---- CRITICAL: saved site pages (scraped content) ----
data/diag/
tests/fixtures/*.mhtml
tests/fixtures/*.mht
tests/fixtures/*.html

# ---- dist artifacts ----
dist/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
build/
*.egg
.venv/
venv/
env/
pip-wheel-metadata/

# ---- local logs (timestamped activity log) ----
logs/
*.log

# ---- pytest / coverage ----
.pytest_cache/
.coverage
htmlcov/
/coverage.xml
# (AndroidManifest.xml and android/res/*.xml are source, not build output:
#  a blanket *.xml rule kept Android unbuildable from a clean clone.)

# ---- IDE ----
.vscode/
.idea/
*.swp
*~

# ---- OS ----
Thumbs.db
.DS_Store

# ---- Node (for any tooling) ----
node_modules/

# ---- Local Android toolchain (JDK + SDK, ~500 MB binaries) ----
tools/jdk8/
tools/sdk/
tools/dl/

# ---- Android (local debug key) ----
android/medo-debug.keystore
android/*.jks
